{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Privacy: Compliance Gate",
            "command": "node",
            "args": [
                "${workspaceFolder}/tools/privacy-gate/privacy-gate.mjs"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "type": "platformio",
            "task": "Build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$platformio"
            ],
            "dependsOn": [
                "Privacy: Compliance Gate"
            ],
            "dependsOrder": "sequence",
            "label": "PlatformIO: Build Firmware"
        },
        {
            "type": "shell",
            "label": "Firebase: Deploy Website (GCP)",
            "command": "firebase deploy --only hosting",
            "options": {
                "cwd": "${workspaceFolder}/platforms/gcp"
            },
            "dependsOn": [
                "Privacy: Compliance Gate"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}