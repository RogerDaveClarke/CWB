rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasMatchingProfileIdentity() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.auth.token.get('email_verified', false) == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email is string
        && request.auth.token.get('email', '').lower()
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower();
    }

    function hasActiveProfile() {
      return hasMatchingProfileIdentity()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function liveRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function liveFunctionLevel() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.functionLevel;
    }

    function isAdmin() {
      return hasActiveProfile()
        && liveRole() == 'admin'
        && request.auth.token.get('admin', false) == true
        && request.auth.token.get('role', '') == 'admin'
        && request.auth.token.get('functionLevel', '') == liveFunctionLevel()
        && request.auth.token.get('firebase', {}).get('sign_in_second_factor', '') == 'totp';
    }

    function hasOperationsAccess() {
      return isAdmin()
        || (hasActiveProfile()
          && liveRole() in ['manager', 'staff']
          && request.auth.token.get('role', '') == liveRole()
          && liveFunctionLevel() == 'operations'
          && request.auth.token.get('functionLevel', '') == liveFunctionLevel());
    }

    function hasMfaOperationsAccess() {
      return isAdmin()
        || (hasActiveProfile()
          && liveRole() in ['manager', 'staff']
          && request.auth.token.get('role', '') == liveRole()
          && liveFunctionLevel() == 'operations'
          && request.auth.token.get('functionLevel', '') == liveFunctionLevel()
          && request.auth.token.get('firebase', {}).get('sign_in_second_factor', '') == 'totp');
    }

    function validBoatConfiguration(boatId) {
      return request.resource.data.device_id == boatId
        && request.resource.data.vessel_name is string
        && request.resource.data.boat_type is string
        && request.resource.data.availability_status in ['available', 'under_repair']
        && request.resource.data.report_interval_minutes is int
        && request.resource.data.report_interval_minutes >= 1
        && request.resource.data.report_interval_minutes <= 60
        && request.resource.data.schedule_year is int
        && request.resource.data.rental_season_start is string
        && request.resource.data.rental_season_end is string
        && request.resource.data.rental_schedule is map;
    }

    function configurationKeys() {
      return [
        'device_id',
        'vessel_name',
        'boat_type',
        'availability_status',
        'report_interval_minutes',
        'schedule_year',
        'rental_season_start',
        'rental_season_end',
        'rental_schedule',
        'configuration_updated_at'
      ];
    }

    function rentalKeys() {
      return [
        'availability_status',
        'tracking_enabled',
        'booked',
        'booked_by',
        'renter_type',
        'passenger_count',
        'rental_type',
        'rental_minutes',
        'time_out',
        'time_due_back',
        'actual_time_back',
        'use_type',
        'event_id',
        'event_name',
        'rental_updated_at'
      ];
    }

    function validRentalState() {
      return request.resource.data.availability_status in ['available', 'rented']
        && request.resource.data.tracking_enabled is bool
        && (!('booked_by' in request.resource.data) || request.resource.data.booked_by is string)
        && (!('renter_type' in request.resource.data) || request.resource.data.renter_type in ['Public', 'Volunteer', 'Dire Hard', 'Libary Pass'])
        && (!('passenger_count' in request.resource.data) || request.resource.data.passenger_count is int)
        && (!('use_type' in request.resource.data) || request.resource.data.use_type in ['rental', 'event', 'authorized_use'])
        && (!('event_id' in request.resource.data) || request.resource.data.event_id is string)
        && (!('event_name' in request.resource.data) || request.resource.data.event_name is string)
        // A boat that is not tracking must not retain renter identity.
        && (request.resource.data.tracking_enabled == true
            || (!('booked_by' in request.resource.data)
              && !('renter_type' in request.resource.data)));
    }

    match /boats/{boatId} {
      allow read: if hasOperationsAccess();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(configurationKeys())
        && validBoatConfiguration(boatId);
      allow update: if hasMfaOperationsAccess()
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(configurationKeys())
            && validBoatConfiguration(boatId))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(rentalKeys())
            && validRentalState())
        );
      allow delete: if isAdmin()
        && (!('tracking_enabled' in resource.data)
        || resource.data.tracking_enabled == false);
      
      match /history/{document} {
        allow read: if hasOperationsAccess();
        allow create, update: if false;
        // Staff erase the journey trail at check-in.
        allow delete: if hasMfaOperationsAccess();
      }
    }

    // Fleet-wide operational settings (e.g. the annual livery closure window).
    // Contains no personal data; read by dashboards and by pushBoatConfig when
    // building tracker downlinks.
    match /fleet_config/{settingId} {
      allow read: if hasOperationsAccess();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['closure_enabled', 'closure_start', 'closure_end', 'updated_at'])
        && request.resource.data.closure_enabled is bool
        && request.resource.data.closure_start is string
        && request.resource.data.closure_end is string;
    }

    match /boat_types/{typeId} {
      allow read: if hasOperationsAccess();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string;
      allow delete: if isAdmin();
    }

    match /rental_history/{recordId} {
      allow read: if hasOperationsAccess();
      // Restricting keys keeps renter identity and coordinates out of the retained log.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'device_id',
          'vessel_name',
          'boat_type',
          'renter_type',
          'checked_out_at',
          'checked_in_at',
          'duration_minutes',
          'passenger_count',
          'use_type',
          'event_id',
          'event_name'
        ])
        && request.resource.data.vessel_name is string
        && request.resource.data.duration_minutes is int;
      allow update, delete: if false;
    }

    match /event_types/{typeId} {
      allow read: if hasOperationsAccess();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'default_duration_minutes', 'active', 'created_at', 'updated_at'])
        && request.resource.data.name is string
        && request.resource.data.default_duration_minutes is int
        && request.resource.data.default_duration_minutes >= 15
        && request.resource.data.default_duration_minutes <= 480
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /user_invitations/{invitationId} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow read: if hasOperationsAccess();
      allow write: if false;

      match /boat_sessions/{boatId} {
        allow read: if hasOperationsAccess();
        allow write: if false;
      }

      match /activity/{activityId} {
        allow read: if hasOperationsAccess();
        allow write: if false;
      }
    }

    // Staff / volunteer account records. This is a NEW category of personal data
    // (staff identity), so it is never world-readable.
    match /users/{userId} {
      // A signed-in user may read their own record; only admins list others.
      allow get: if isAdmin() || (request.auth.uid == userId && hasMatchingProfileIdentity());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /lifecycle_notification_outbox/{notificationId} {
      allow read, write: if false;
    }
  }
}