rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validBoatConfiguration(boatId) {
      return request.resource.data.device_id == boatId
        && request.resource.data.vessel_name is string
        && request.resource.data.availability_status in ['available', 'under_repair']
        && request.resource.data.schedule_year is int
        && request.resource.data.rental_season_start is string
        && request.resource.data.rental_season_end is string
        && request.resource.data.rental_schedule is map;
    }

    match /boats/{boatId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'device_id',
          'vessel_name',
          'availability_status',
          'schedule_year',
          'rental_season_start',
          'rental_season_end',
          'rental_schedule',
          'configuration_updated_at'
        ])
        && validBoatConfiguration(boatId);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'device_id',
          'vessel_name',
          'availability_status',
          'schedule_year',
          'rental_season_start',
          'rental_season_end',
          'rental_schedule',
          'configuration_updated_at'
        ])
        && validBoatConfiguration(boatId);
      allow delete: if false;
      
      match /history/{document} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}