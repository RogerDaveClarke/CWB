rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /boats/{boatId} {
      allow read: if true; 
      allow write: if false; // Tightly bound security lockdown; only Cloud Functions IAM permissions bypass this
      
      match /history/{document} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}